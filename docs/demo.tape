# Recorded with `vhs docs/demo.tape` from the repo root (needs paper-repro on PATH).
Output docs/demo.gif
Set Shell "bash"
Set FontSize 13
Set Width 1180
Set Height 720
Set Padding 16
Set TypingSpeed 35ms
Hide
Type "PS1='$ ' && cd $(mktemp -d) && paper-repro --version >/dev/null && clear"
Enter
Sleep 3s
Show
Type "paper-repro inspect tkipf/pygcn"
Sleep 400ms
Enter
Sleep 5s
Type "paper-repro paper"
Sleep 400ms
Enter
Sleep 12s
